# =============================================================================
# Restaurant Platform API - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3001

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://restaurant:restaurant_dev_password@localhost:5432/restaurant_platform?schema=public

# --- Redis (carts, cache, rate limiting, idempotency) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# --- Application-level encryption (used to encrypt Clover OAuth tokens at rest) ---
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-string-min-32-chars

# --- Clover Integration ---
# CLOVER_ENVIRONMENT must be either "sandbox" or "production".
CLOVER_ENVIRONMENT=sandbox
CLOVER_CLIENT_ID=
CLOVER_CLIENT_SECRET=
CLOVER_MERCHANT_ID=
CLOVER_REDIRECT_URI=http://localhost:3000/api/v1/integrations/clover/oauth/callback
CLOVER_WEBHOOK_SECRET=
CLOVER_ECOMMERCE_PUBLIC_KEY=
CLOVER_ECOMMERCE_PRIVATE_KEY=
# CLOVER_API_BASE_URL / CLOVER_OAUTH_WEB_BASE_URL are optional - when unset, the
# ConfigModule derives the correct sandbox/production hosts from CLOVER_ENVIRONMENT
# (see src/config/clover.config.ts). Override only for a non-North-America region.
CLOVER_API_BASE_URL=
CLOVER_OAUTH_WEB_BASE_URL=
# When true (or when CLOVER_CLIENT_ID/SECRET are unset), Clover calls are served by
# the in-memory mock adapter instead of real Clover APIs - see CLOVER_SETUP_GUIDE.md.
CLOVER_USE_MOCK_CLIENT=true

# --- Firebase (Cloud Messaging, Crashlytics/Analytics server-side needs, if any) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the escaped \n newlines when pasting the private key from the service account JSON.
FIREBASE_PRIVATE_KEY=

# --- Feature flags / business config defaults (overridable per-restaurant in DB later) ---
DEFAULT_CURRENCY=USD
DEFAULT_COUNTRY=US
DEFAULT_PREP_TIME_MINUTES=25
GUEST_CHECKOUT_ENABLED=true
